# Reference settings for direct host execution. The portable Docker installer
# generates its own environment; use runtime/deployment/caller-overrides.json.
# Paths
CSV_PATH=data/students.example.csv
RECORDINGS_DIR=/tmp/recordings
RECORD_SILENCE_SECONDS=1
RECORD_MAX_SECONDS=12
REQUIRE_PREPARED_CALL_AUDIO=true
PREPARE_QUERY_AUDIO=true
COLLEGE_NAME=your college

# Marks (CSV values are out of this per subject)
MAX_MARKS_PER_SUBJECT=100

# Verification
NAME_MATCH_THRESHOLD=0.72
MAX_VERIFY_ATTEMPTS=2

# Selected local LLM. Run the portable installer before using this model name.
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11444
OLLAMA_MODEL=gemma4-e2b-college:qat4
OLLAMA_THINK=false
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_KEEP_ALIVE=15m
OLLAMA_NUM_CTX=4096
LLM_UNDERSTAND_EVERY_INPUT=true
OLLAMA_NUM_THREADS=4
OLLAMA_NUM_PREDICT=96
LLM_GENERATE_REPLIES=true

# One resident Meta CTC model; see OPTIMIZED_SPEECH_SETUP.md for ONNX workers.
STT_ENGINE=meta_omnilingual
# Optional Gemma audio challenger: set STT_ENGINE=gemma_audio after provisioning.
GEMMA_RUNNER=tools/llama-b11304/llama-mtmd-cli
GEMMA_MODEL=models/gemma-4-E2B-it-qat-q4_0-gguf/gemma-4-E2B_q4_0-it.gguf
GEMMA_MMPROJ=models/gemma-4-E2B-it-qat-q4_0-gguf/gemma-4-E2B-it-mmproj.gguf
GEMMA_TIMEOUT_SECONDS=120

# Optional resident Meta ASR service in Linux/Docker; one model handles en/hi/kn.
META_STT_URL=http://127.0.0.1:8110
META_STT_TIMEOUT_SECONDS=120
# Experimental live parent audio: see STREAMING_STT_2026-10-07.md.
# Same Docker network as PBX: advertise the caller container's DNS name.
STREAMING_STT_ENABLED=false
STREAMING_AUDIO_BIND_HOST=0.0.0.0
STREAMING_AUDIO_ADVERTISE_HOST=college-caller
STREAMING_AUDIO_PORT=20100
STREAMING_AUDIO_PORTS=4
STREAMING_ENDPOINT_SECONDS=1.0
STREAMING_PARTIAL_MIN_SECONDS=4.0
STREAMING_PARTIAL_STEP_SECONDS=3.0
# One prefix per turn avoids a second decode blocking final ASR on this CPU.
# Zero keeps live RTP and endpointing but disables prefix requests.
STREAMING_PARTIAL_MAX_REQUESTS=1
# Optional validated Qwen draft preparation; adds CPU load.
STREAMING_PREFETCH_LLM=false

# faster-whisper fallback (local STT)
WHISPER_MODEL=models/faster-whisper-small
WHISPER_MULTILINGUAL_MODEL=models/faster-whisper-small
WHISPER_KANNADA_MODEL=models/whisper-kannada-ct2
# whisper uses language-specific fallbacks; whisper_unified uses WHISPER_MODEL for en/hi/kn.
INDIC_CONFORMER_MODEL=models/indic-conformer-600m-multilingual
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Selected VoiceAPI VITS voices for English, Hindi and Kannada.
# Indic Parler and the older local backends are optional alternatives.
TTS_ENGINE=voiceapi_vits
VITS_URL=http://127.0.0.1:8112
VITS_TIMEOUT_SECONDS=90
PIPER_BIN=piper
PIPER_MODEL=models/en_US-lessac-medium.onnx
PIPER_HINDI_MODEL=models/hi_IN-rohan-medium.onnx
MMS_KANNADA_MODEL=models/mms-tts-kan
INDIC_PARLER_MODEL=models/indic-parler-tts
INDIC_PARLER_DESCRIPTION_TOKENIZER=models/indic-parler-description-tokenizer
KOKORO_VOICE=af_heart
TTS_SAMPLE_RATE=16000

# Asterisk ARI + local Zoiper lab
ARI_ENABLED=true
ARI_URL=http://127.0.0.1:8088/ari
ARI_USER=asterisk
ARI_PASSWORD=change-me
ARI_APP=parent-marks
# Must be the same directory Asterisk sees under /var/lib/asterisk/sounds.
# If the app runs in a container, bind-mount this directory into both services.
ASTERISK_SOUNDS_DIR=/var/lib/asterisk/sounds/parent-marks
SIP_ENDPOINT=PJSIP
SIP_TRUNK=zoiper1
# e164_digits sends 9198..., e164_plus sends +9198..., national sends 98...
SIP_DIAL_FORMAT=e164_digits
# For a real trunk, use the caller ID/DID supplied by the provider.
OUTBOUND_CALLER_ID=College <1000>

# FastAGI (inbound dial 1001 — optional if you use ARI originate)
AGI_HOST=127.0.0.1
AGI_PORT=4573

# FastAPI
APP_HOST=127.0.0.1
APP_PORT=8000
# Required if APP_HOST is changed to a network address.
ADMIN_API_TOKEN=
# Ask the parent to choose English, Hindi or Kannada before confirmation.
ASK_LANGUAGE_BEFORE_IDENTITY=true
# Experimental Bluetooth SIM route: enable only after phone/audio validation.
OUTBOUND_CHANNEL_DRIVER=pjsip
MOBILE_DEVICE=samsung
